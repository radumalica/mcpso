    "markdown-it": "^14.1.0",
    "moment": "^2.30.1",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.4.0",
    "react-lazy-load-image-component": "^1.6.2",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
