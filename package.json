{
  "name": "mcp-registry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "watch": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib models utils",
    "test": "node --test tests/security/*.test.mjs tests/app/*.test.mjs tools/upstream-import/test/*.test.mjs",
    "test:db": "npm --prefix db/tests test",
    "test:e2e": "next build && node --test tests/e2e/site.test.mjs",
    "typecheck": "tsc --noEmit",
    "secrets": "node tools/ci/secret-scan.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.46.2",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
